# Public API URL included in the frontend bundle at image build time.
# Use the URL that the user's browser can reach.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# API URL used by server-side rendering inside the container.
# For a backend running in a separate container, use its reachable address.
SERVER_API_URL=http://host.docker.internal:4000/api

FRONTEND_PORT=3000
